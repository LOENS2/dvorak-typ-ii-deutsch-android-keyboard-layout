#
# German Dvorak Type 2 keyboard layout.
#

type OVERLAY

# Hardware Scancodes Remapping to Linux Keycodes (Dvorak Typ 2 Map)
map key 12 SLASH
map key 21 Z
map key 44 Y
map key 53 MINUS
map key 86 PLUS

### ROW 1

key GRAVE {
    label:                              '^'
    base:                               '^'
    shift:                              '\u00b0'
}

key 1 {
    label:                              '1'
    base:                               '1'
    shift:                              '!'
}

key 2 {
    label:                              '2'
    base:                               '2'
    shift:                              '"'
    ralt:                               '\u00b2'
}

key 3 {
    label:                              '3'
    base:                               '3'
    shift:                              '\u00a7'
    ralt:                               '\u00b3'
}

key 4 {
    label:                              '4'
    base:                               '4'
    shift:                              '$'
}

key 5 {
    label:                              '5'
    base:                               '5'
    shift:                              '%'
}

key 6 {
    label:                              '6'
    base:                               '6'
    shift:                              '&'
}

key 7 {
    label:                              '7'
    base:                               '7'
    shift:                              '/'
    ralt:                               '{'
}

key 8 {
    label:                              '8'
    base:                               '8'
    shift:                              '('
    ralt:                               '['
}

key 9 {
    label:                              '9'
    base:                               '9'
    shift:                              ')'
    ralt:                               ']'
}

key 0 {
    label:                              '0'
    base:                               '0'
    shift:                              '='
    ralt:                               '}'
}

key SLASH {
    label:                              '+'
    base:                               '+'
    shift:                              '*'
    ralt:                               '~'
}

key EQUALS {
    label:                              '<'
    base:                               '<'
    shift:                              '>'
    ralt:                               '`'
}

### ROW 2 (Dvorak Top Row)

key Q {
    label:                              '\u00dc'
    base:                               '\u00fc'
    shift, capslock:                    '\u00dc'
    ralt:                               '@'
}

key W {
    label:                              ','
    base:                               ','
    shift, capslock:                    ';'
}

key E {
    label:                              '.'
    base:                               '.'
    shift, capslock:                    ':'
}

key R {
    label:                              'P'
    base:                               'p'
    shift, capslock:                    'P'
}

key T {
    label:                              'Y'
    base:                               'y'
    shift, capslock:                    'Y'
}

key Z {
    label:                              'F'
    base:                               'f'
    shift, capslock:                    'F'
}

key U {
    label:                              'G'
    base:                               'g'
    shift, capslock:                    'G'
}

key I {
    label:                              'C'
    base:                               'c'
    shift, capslock:                    'C'
}

key O {
    label:                              'T'
    base:                               't'
    shift, capslock:                    'T'
}

key P {
    label:                              'Z'
    base:                               'z'
    shift, capslock:                    'Z'
}

key LEFT_BRACKET {
    label:                              '?'
    base:                               '?'
    shift:                              '\u00df'
}

key RIGHT_BRACKET {
    label:                              '/'
    base:                               '/'
    shift:                              '\\'
    ralt:                               '\''
}

### ROW 3 (Dvorak Home Row)

key A {
    label:                              'A'
    base:                               'a'
    shift, capslock:                    'A'
    ralt:                               '@'
}

key S {
    label:                              'O'
    base:                               'o'
    shift, capslock:                    'O'
}

key D {
    label:                              'E'
    base:                               'e'
    shift, capslock:                    'E'
    ralt:                               '\u20ac'
}

key F {
    label:                              'I'
    base:                               'i'
    shift, capslock:                    'I'
}

key G {
    label:                              'U'
    base:                               'u'
    shift, capslock:                    'U'
}

key H {
    label:                              'H'
    base:                               'h'
    shift, capslock:                    'H'
}

key J {
    label:                              'D'
    base:                               'd'
    shift, capslock:                    'D'
}

key K {
    label:                              'R'
    base:                               'r'
    shift, capslock:                    'R'
    ralt:                               '\u00ae'
}

key L {
    label:                              'N'
    base:                               'n'
    shift, capslock:                    'N'
}

key SEMICOLON {
    label:                              'S'
    base:                               's'
    shift, capslock:                    'S'
}

key APOSTROPHE {
    label:                              'L'
    base:                               'l'
    shift, capslock:                    'L'
}

key BACKSLASH {
    label:                              '-'
    base:                               '-'
    shift:                              '_'
}

### ROW 4 (Dvorak Bottom Row)

key PLUS {
    label:                              '\u00c4'
    base:                               '\u00e4'
    shift:                              '\u00c4'
}

key Y {
    label:                              '\u00d6'
    base:                               '\u00f6'
    shift, capslock:                    '\u00d6'
}

key X {
    label:                              'Q'
    base:                               'q'
    shift, capslock:                    'Q'
}

key C {
    label:                              'J'
    base:                               'j'
    shift, capslock:                    'J'
}

key V {
    label:                              'K'
    base:                               'k'
    shift, capslock:                    'K'
}

key B {
    label:                              'X'
    base:                               'x'
    shift, capslock:                    'X'
}

key N {
    label:                              'B'
    base:                               'b'
    shift, capslock:                    'B'
}

key M {
    label:                              'M'
    base:                               'm'
    shift, capslock:                    'M'
    ralt:                               '\u00b5'
}

key COMMA {
    label:                              'W'
    base:                               'w'
    shift, capslock:                    'W'
}

key PERIOD {
    label:                              'V'
    base:                               'v'
    shift, capslock:                    'V'
}

key MINUS {
    label:                              '#'
    base:                               '\''
    shift:                              '#'
}